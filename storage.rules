// Regole di Firebase Storage per il bucket `kidbox-42cd7-eu` (l'unico usato dai
// client). Scaricate dalla produzione l'11/11/2026: fino ad allora vivevano solo
// nella console Firebase (ultima pubblicazione 20/04/2026). Il contenuto sotto è
// identico a quello pubblicato; questo commento è l'unica aggiunta.
// Deploy: `npx firebase-tools deploy --only storage --project kidbox-42cd7`.
// Nota: qui «membro» = il documento membro ESISTE; in firestore.rules è più
// stretto (non cancellato e con `role`). Da riallineare con una modifica a parte.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/families/$(familyId)/members/$(request.auth.uid)
        );
    }

    // HERO photo
    match /families/{familyId}/hero/hero.jpg {
      allow read, write: if isFamilyMember(familyId);
    }

    // Avatar img
    match /families/{familyId}/avatars/{uid} {
      allow read, write: if isFamilyMember(familyId);
    }

    // USER avatar (profile picture) quando ancora non c'è la famiglia
    match /users/{uid}/avatar.jpg {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /families/{familyId}/chat/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }

    // DOCUMENTS files
    match /families/{familyId}/documents/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }

    // TREATMENT ATTACHMENTS files (encrypted)
    match /families/{familyId}/treatment-attachments/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }

    // VISIT ATTACHMENTS files (encrypted)
    match /families/{familyId}/visit-attachments/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }

    // EXAM ATTACHMENTS files (encrypted)
    match /families/{familyId}/exam-attachments/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }

    // PHOTO & VIDEO files (encrypted with family master key)
    match /families/{familyId}/photos/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }

    // WALLET tickets (PDF cifrati con chiave della famiglia)
    // Path: families/{familyId}/wallet/{ticketId}/ticket.pdf.kbenc
    match /families/{familyId}/wallet/{allPaths=**} {
      allow read, write: if isFamilyMember(familyId);
    }
  }
}
