    "L'assistente legge il documento, capisce cos'è e lo smista nella sezione giusta. Ogni pagina letta costa un messaggio AI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant reads the document, works out what it is and files it in the right section. Each page read costs one AI message."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant lit le document, comprend ce que c'est et le range dans la bonne section. Chaque page lue coûte un message IA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente lee el documento, entiende qué es y lo guarda en la sección correcta. Cada página leída cuesta un mensaje de IA."
          }
        }
      }
    },
