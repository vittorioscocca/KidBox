    "Lavoro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travail"
          }
        }
      }
    },
    "Apri KidBox per aggiungere il documento a Lavoro." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open KidBox to add the document to Work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre KidBox para añadir el documento a Trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre KidBox pour ajouter le document à Travail."
          }
        }
      }
    },
    "Il documento va nella tua scheda Lavoro (busta paga, contratto, foglio ferie). La lettura parte solo quando la chiedi, dentro KidBox: ogni pagina letta costa un messaggio AI." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document goes into your Work card (payslip, contract, leave sheet). It is read only when you ask, inside KidBox: each page read costs one AI message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento va a tu ficha de Trabajo (nómina, contrato, hoja de vacaciones). Solo se lee cuando lo pides, dentro de KidBox: cada página leída cuesta un mensaje de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document va dans ta fiche Travail (fiche de paie, contrat, planning de congés). Il n'est lu que lorsque tu le demandes, dans KidBox : chaque page lue coûte un message IA."
          }
        }
      }
    },
    "Invia a Lavoro" : {
