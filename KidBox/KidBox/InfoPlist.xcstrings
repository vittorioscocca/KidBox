{
  "sourceLanguage": "it",
  "strings": {
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "new",
            "value": "KidBox"
          }
        }
      }
    },
    "KidBox Password Export": {},
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox schedules an alarm for reminders you mark as urgent, so they ring even on silent or during a Focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox programa una alarma para los recordatorios marcados como urgentes, para que suenen aunque el teléfono esté en silencio o con un modo de concentración activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox programme une alarme pour les rappels marqués comme urgents, afin qu'ils sonnent même en silencieux ou en mode Concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox programma una sveglia per i promemoria che segni come urgenti, così suonano anche in silenzioso o in full immersion."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - Calendars Full Access Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox shows events from this device's calendars (Google, iCloud, Outlook) in its own calendar. They stay on the device: your family only sees the ones you copy to KidBox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox muestra en su calendario los eventos de los calendarios de este dispositivo (Google, iCloud, Outlook). Se quedan en el dispositivo: tu familia solo ve los que copias a KidBox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox affiche dans son calendrier les événements des calendriers de cet appareil (Google, iCloud, Outlook). Ils restent sur l'appareil : votre famille ne voit que ceux que vous copiez dans KidBox."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox mostra nel suo calendario gli eventi dei calendari di questo dispositivo (Google, iCloud, Outlook). Restano sul dispositivo: la famiglia vede solo quelli che copi in KidBox."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to take and save documents/photos in KidBox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para hacer y guardar documentos/fotos en KidBox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert à prendre et enregistrer des documents/photos dans KidBox."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per scattare e salvare documenti/foto in KidBox."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "comment": "Privacy - Contacts Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox uses your contacts to let you share a contact in chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa tus contactos para permitirte compartir un contacto en el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox utilise vos contacts pour vous permettre de partager un contact dans le chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa i contatti per permetterti di condividere un contatto in chat."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Privacy - Health Share Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox reads weight, blood type, heart rate and activity from Apple Health to fill in the medical record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox lee el peso, el grupo sanguíneo, la frecuencia cardíaca y la actividad de Apple Salud para rellenar la ficha médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox lit le poids, le groupe sanguin, la fréquence cardiaque et l'activité depuis Apple Santé pour remplir la fiche médicale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox legge peso, gruppo sanguigno, frequenza cardiaca e attività da Apple Salute per compilare la scheda medica."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Privacy - Health Update Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox does not write data to Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox no escribe datos en Apple Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox n'écrit aucune donnée dans Apple Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox non scrive dati in Apple Salute."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - Location Always and When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox uses your location in the background to update it even when the app isn't open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa tu ubicación en segundo plano para actualizarla incluso cuando la app no está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox utilise votre position en arrière-plan pour la mettre à jour même lorsque l'app n'est pas ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa la tua posizione in background per aggiornarla anche quando l'app non è aperta."
          }
        }
      }
    },
    "NSLocationAlwaysUsageDescription": {
      "comment": "Privacy - Location Always Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox uses your location in the background to update it even when the app isn't open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa tu ubicación en segundo plano para actualizarla incluso cuando la app no está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox utilise votre position en arrière-plan pour la mettre à jour même lorsque l'app n'est pas ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa la tua posizione in background per aggiornarla anche quando l'app non è aperta."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox uses your location to show it to family members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa tu ubicación para mostrarla a los miembros de la familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox utilise votre position pour la montrer aux membres de la famille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa la tua posizione per mostrarla ai membri della famiglia."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox uses the microphone to record voice messages in chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa el micrófono para grabar mensajes de voz en el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox utilise le microphone pour enregistrer des messages vocaux dans le chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KidBox usa il microfono per registrare messaggi vocali in chat."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to the library to upload photos to documents"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la fototeca para subir las fotos a los documentos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à la photothèque pour charger les photos dans les documents"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso alla libreria per caricare le foto nei documenti"
          }
        }
      }
    }
  },
  "version": "1.0"
}
