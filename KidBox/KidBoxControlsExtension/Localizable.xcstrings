    "Scegli cosa mostrare: calendario, to-do, spesa, cure, piano fitness o foto.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to show: calendar, to-dos, shopping, treatments, fitness plan or photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué mostrar: calendario, tareas, compra, tratamientos, plan fitness o fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quoi afficher : calendrier, tâches, courses, soins, plan fitness ou photos."
          }
        }
      }
    },
    "Scegli di chi mostrare il piano. Senza scelta vedi il primo piano trovato.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whose plan to show. With no choice you see the first plan found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de quién mostrar el plan. Sin elección, el primer plan encontrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez de qui afficher le plan. Sans choix, le premier plan trouvé."
          }
        }
      }
    },
    "Scegli di chi mostrare le cure. Senza scelta vedi tutta la famiglia.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whose treatments to show. With no choice you see the whole family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de quién mostrar los tratamientos. Sin elección, toda la familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez de qui afficher les soins. Sans choix, toute la famille."
          }
        }
      }
    },
    "Scegli la lista da mostrare. Senza scelta vedi tutti i to-do.": {
      "extractionState": "manual",
