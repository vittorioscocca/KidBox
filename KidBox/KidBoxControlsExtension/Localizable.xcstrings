    "Calendario, to-do, spesa, cure o piano fitness: scegli da «Modifica widget».": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar, to-dos, shopping, treatments or fitness plan: choose from “Edit Widget”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario, tareas, compra, tratamientos o plan fitness: elige en «Editar widget»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier, tâches, courses, soins ou plan fitness : choisissez dans « Modifier le widget »."
          }
        }
      }
    },
