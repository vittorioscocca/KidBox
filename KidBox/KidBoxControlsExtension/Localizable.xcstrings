    "Scegli la lista da mostrare. Senza scelta vedi tutti i to-do.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the list to show. With no choice you see all to-dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la liste à afficher. Sans choix, tout est affiché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la lista que mostrar. Sin elección verás todas las tareas."
          }
        }
      }
    },
    "Scegli di chi mostrare le cure. Senza scelta vedi tutta la famiglia.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whose treatments to show. With no choice you see the whole family."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez de qui afficher les soins. Sans choix, toute la famille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de quién mostrar los tratamientos. Sin elección, toda la familia."
          }
        }
      }
    },
    "Scegli di chi mostrare il piano. Senza scelta vedi il primo piano trovato.": {
