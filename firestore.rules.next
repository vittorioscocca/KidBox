// ⏳ VERSIONE FUTURA — non è questa che si deploya.
//
// Identica a `firestore.rules` tranne i blocchi marcati `BEGIN next:`: le chat
// AI in `users/{uid}/aiConversations` e i fatti della memoria di famiglia in
// `families/{id}/memoryFacts` si scrivono solo cifrati.
//
// Le app già installate scrivono in chiaro: con questa regola attiva le build
// iOS vecchie smettono di sincronizzare le chat AI (restano sul telefono) e
// quelle iOS/Android vecchie non salvano più fatti nuovi sul server. Diventa
// `firestore.rules` insieme all'interruttore Remote Config
// `ai_conversations_encrypted`, quando la build iOS che cifra è diffusa
// (criterio in `/rules-change`). Disegno in `internal/assistente-unico.md`.
//
// Le altre modifiche si fanno su `firestore.rules` e si riportano qui:
// `firestore-tests/rules.test.js` gira su entrambi i file e fallisce se
// divergono fuori da questi blocchi.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ADMIN ──────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "efw85HN41nb1rmslevC3wkFpVUo1";
    }

    // BEGIN next:aiConversations-fn
    // Una scrittura su `users/{uid}/aiConversations` non porta testo in chiaro.
    // Si guardano solo i campi che la scrittura tocca: segnare `isDeleted` su un
    // documento ancora in chiaro dev'essere possibile. Basta il primo messaggio:
    // i client vecchi scrivono `content` in tutti, quelli nuovi in nessuno.
    function aiConversationWriteIsEncrypted() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['summary']) || !(d.get('summary', null) is string))
          && (!changed.hasAny(['messages'])
              || d.get('messages', []).size() == 0
              || !('content' in d.messages[0]));
    }

    // Un fatto della memoria di famiglia non porta il testo in chiaro (`content`
    // nei campi che la scrittura tocca). Cancellare resta libero ai membri.
    function memoryFactWriteIsEncrypted() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return !changed.hasAny(['content']) || !(d.get('content', null) is string);
    }
    // END next:aiConversations-fn

    // ── APP HELPERS ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── ANALYTICS ──────────────────────────────────────────
    // Vedi internal/analytics-active-users.md.
    //
    // Top-level e NON sotto families/{familyId}: quel ramo è leggibile da ogni
    // membro (isMemberOrOwner), quindi il log delle letture diventerebbe un
    // registro di chi-ha-guardato-cosa consultabile dal partner.
    //
    // Append-only: il client scrive e non rilegge mai. Rollup e console passano
    // dall'Admin SDK, che bypassa le rules.
    match /analyticsEvents/{eventId} {
      // `expiresAt` è il campo della TTL policy (90gg): data di morte, non di
      // nascita. La policy NON va puntata su `ts`, che è già nel passato alla
      // scrittura e cancellerebbe ogni evento appena creato.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['name', 'uid', 'familyId', 'feature', 'ts', 'expiresAt', 'props']);
      allow read, update, delete: if false;
    }

    // Configurazione remota letta dai client (oggi: `config/nudges`).
    // Non contiene dati di nessun utente — solo testi, cadenze e interruttori —
    // quindi la lettura è aperta a chiunque sia autenticato. La scrittura resta
    // negata ai client: si modifica dalla console con l'Admin SDK, che le rules
    // non le attraversa.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Il listino piani lo legge anche la landing, che non ha nessun utente
    // loggato: lettura aperta. Contiene solo prezzi, quote e testi di
    // marketing — le stesse cose stampate sul sito — e nessun dato di nessuno.
    // Non aggiungere altro a questo documento.
    match /config/plans {
      allow read: if true;
      allow write: if false;
    }

    // Rollup giornalieri: scritti dallo scheduler, letti solo dalla console.
    match /metrics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    function isMember(familyId) {
      // `get('isDeleted', false)` e non `.isDeleted`: su un documento senza il
      // campo l'accesso diretto va in ERRORE di valutazione, e l'errore nega.
      // Il campo manca proprio sul membro owner creato da iOS e dal web
      // (`createFamilyWithChild`, `createFamily`); finché è owner passa da
      // `isOwner`, ma dopo il passaggio di proprietà diventa membro semplice e
      // restava chiuso fuori: su Android l'uscita falliva rileggendo la
      // famiglia, sul web elencando i membri, a proprietà già ceduta.
      // Assente = non cancellato, come già lo leggono i client
      // (`isDeleted !== true` sul web). Verificato il 14/09/2026.
      //
      // `role` invece è obbligatorio. iOS e web aggiornano il nome con
      // `setData({displayName, updatedAt}, merge)` sul documento membro: se nel
      // frattempo il membro è stato revocato cancellando il documento (iOS, web),
      // quella scrittura lo RICREA con solo nome e data. Con `isDeleted` letto
      // come assente = attivo, un documento così avrebbe riaperto la famiglia a
      // chi ne era stato tolto. Ogni creazione vera di un membro scrive `role`
      // (creazione famiglia e join, su tutti i client), e il 14/09/2026 nessun
      // membro di una famiglia esistente ne era privo.
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && ('role' in get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.get('isDeleted', false) != true;
    }

    function isOwner(familyId) {
      return isSignedIn() && (
        (resource != null && resource.data.ownerUid == request.auth.uid) ||
        get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid
      );
    }

    // Prova che un'auto-iscrizione nasce da un invito davvero consumato.
    //
    // `JoinWrapService` (iOS e Android) valida l'invito in transazione — scadenza,
    // `usedAt` nullo, hash del segreto — e lo marca `usedBy = uid`. Il client
    // riporta poi quell'id sul documento membro, e qui si verifica che i due
    // combacino: senza un invito marcato a proprio nome non si entra.
    //
    // Attenzione: l'hash del segreto lo verifica il CLIENT, non le rules. Ciò
    // che impedisce a un estraneo di marcarsi un invito è la regola di
    // `invites` qui sotto: non può elencarli (quindi l'id lo ha solo chi ha il
    // link), non può crearne, e può consumarne uno solo prima della scadenza.
    // Senza quelle tre condizioni questa funzione non chiuderebbe nulla.
    //
    // L'invito NON viene più cancellato dopo l'uso proprio per poter fare questo
    // controllo; resta a uso singolo perché `allow update` qui sotto lo lascia
    // marcare solo finché `usedAt` è nullo.
    function joinedWithValidInvite(familyId) {
      // `let` e non l'espressione ripetuta dentro `$(...)`: il compilatore delle
      // rules avverte «Invalid variable name: request.» quando in un segmento di
      // path si interpola un'espressione puntata invece di una variabile.
      let inviteId = request.resource.data.get('inviteId', '');
      return inviteId is string
        && inviteId != ''
        && exists(/databases/$(database)/documents/families/$(familyId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/families/$(familyId)/invites/$(inviteId))
             .data.get('usedBy', '') == request.auth.uid;
    }

    function isMemberOrOwner(familyId) {
      return isOwner(familyId) || isMember(familyId);
    }

    // ── PIANO: scrivibile SOLO lato server ─────────────────
    // Prima il client scriveva da sé `plan` dopo l'acquisto e le rules glielo
    // permettevano: bastava una scrittura per regalarsi Pro/Max senza pagare.
    // Ora l'unica via è la callable `validatePurchase`, che verifica la ricevuta,
    // e `setFamilyPlanOverride` per la console admin. Entrambe usano l'Admin SDK,
    // che NON attraversa queste rules — quindi continuano a funzionare.
    function planFields() {
      return ['plan', 'planOverride', 'planUpdatedAt', 'planExpiresAt',
              'planSource', 'planVerifiedBy', 'planOverrideNote',
              'planOverrideSetAt', 'planOverrideSetBy'];
    }

    // Su create non esiste `resource`: si guardano le chiavi in arrivo.
    function createsNoPlanField() {
      return !request.resource.data.keys().hasAny(planFields());
    }

    // Su update conta solo ciò che cambia: gli altri campi restano modificabili.
    function keepsPlanFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(planFields());
    }

    // Numero di famiglie già possedute dall'utente.
    // La fonte è `user_quotas/{uid}`, mantenuto SOLO dall'Admin SDK (trigger
    // onFamilyCreatedQuota/onFamilyDeletedQuota): non può stare su `users/{uid}`,
    // che l'utente può riscrivere a piacere e falsificherebbe il limite.
    // Documento assente = 0, così gli account creati prima del limite non si bloccano.
    function ownedFamilyCount() {
      return exists(/databases/$(database)/documents/user_quotas/$(request.auth.uid))
        ? get(/databases/$(database)/documents/user_quotas/$(request.auth.uid)).data.get('ownedFamilies', 0)
        : 0;
    }

    // ── ADMIN: lettura globale, nessuna scrittura ──────────
    match /{document=**} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── USERS ──────────────────────────────────────────────
    match /users/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      // `users/{uid}.plan` è il fallback letto dal server per le quote:
      // se restasse scrivibile, basterebbe scriverlo per ottenere Max.
      allow create: if isSignedIn() && request.auth.uid == uid && createsNoPlanField();
      allow update: if isSignedIn() && request.auth.uid == uid && keepsPlanFields();

      match /memberships/{familyId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }

      // ── SESSIONI (un documento per dispositivo) ────────────
      // L'elenco dei dispositivi collegati, e la leva del logout remoto: ogni
      // client ascolta il PROPRIO documento e si slogga quando sparisce.
      // `delete` da un altro dispositivo dello stesso account è il punto di
      // tutta la feature, perciò vale la stessa regola degli altri: chiunque
      // sia loggato come questo uid può toccarli.
      match /sessions/{sessionId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }

      // ── CHAT AI (private per-utente, sync cross-device) ────
      // BEGIN next:aiConversations
      // ⏳ Regola in attesa: testo dei messaggi e riassunto solo cifrati
      // (`contentEnc`, `summaryEnc`). Le build iOS che non cifrano ancora
      // riscriverebbero in chiaro l'intero array e cancellerebbero i messaggi
      // che non sanno leggere: qui la loro scrittura viene negata (smettono di
      // sincronizzare le chat AI, non perdono niente).
      match /aiConversations/{conversationId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid
                              && aiConversationWriteIsEncrypted();
      }
      // END next:aiConversations

      // ── PIANO ALIMENTARE (privato per-utente, sync cross-device) ──
      // Sta sotto `users` e non sotto `families` di proposito: contiene peso,
      // obiettivo e abitudini alimentari di chi lo genera, e sotto `families`
      // il wildcard `{subpath=**}` lo renderebbe leggibile a tutta la famiglia.
      match /mealPlans/{childId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }

      // ── PIANO FITNESS (privato per-utente, sync cross-device) ──
      // Stesso ragionamento del piano alimentare: contiene peso, obiettivi,
      // infortuni e adattamenti clinici di chi lo genera.
      match /fitnessPlans/{childId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Contatore famiglie possedute: l'utente può leggere il proprio (per mostrare
    // il limite in UI), ma la scrittura è riservata all'Admin SDK, che ignora le rules.
    match /user_quotas/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── FAMILIES ───────────────────────────────────────────
    // ── I PROPRI DOCUMENTI MEMBRO, OVUNQUE SIANO ──────────
    //
    // Una query di collection group NON passa dalle `match` annidate sotto
    // `families/{familyId}`: per Firestore è un'altra cosa, e senza una regola
    // a livello di collection group viene negata e basta.
    //
    // Serve a ritrovare le proprie famiglie quando l'indice
    // `users/{uid}/memberships` è incompleto. Quell'indice è una copia: la
    // verità su chi è membro di cosa sta nei documenti membro. Android ha
    // sempre avuto questo fallback nel codice, ma falliva in silenzio dentro un
    // try/catch — mancavano sia la regola sia l'esenzione di indice.
    //
    // Non apre niente: la query è accettata solo se filtra sul proprio uid
    // (`where("uid", "==", auth.uid)`), quindi restituisce soltanto documenti
    // che descrivono l'appartenenza di chi la fa; senza quel filtro resta
    // negata. Il capture `**` non viene letto — leggerlo negherebbe ogni LIST
    // (vedi la nota sul wildcard delle sottocollezioni). `data.get('uid', '')`
    // e non `.uid`: un documento senza quel campo darebbe errore di
    // valutazione, e l'errore nega l'intera query.
    match /{path=**}/members/{memberId} {
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
    }

    match /families/{familyId} {
      // Massimo 2 famiglie create per account.
      // `createsNoPlanField()` impedisce di nascere già Pro/Max: senza quel
      // controllo bastava creare una famiglia con `plan: "max"` per aggirare tutto.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ownedFamilyCount() < 2
        && createsNoPlanField();

      allow read, delete: if isMemberOrOwner(familyId);
      allow update: if isMemberOrOwner(familyId) && keepsPlanFields();

      match /members/{uid} {
        // L'auto-iscrizione non è più libera. Prima bastava `uid ==
        // request.auth.uid`: chiunque fosse autenticato e conoscesse il
        // `familyId` — che viaggia in chiaro nel QR e nel link d'invito —
        // poteva aggiungersi da sé a una famiglia altrui e leggerne i dati.
        // Ora chi si iscrive deve esibire l'invito che ha consumato.
        //
        // In produzione dal 01/10/2026. Fino ad allora la regola aspettava in
        // un file a parte: le app precedenti alla 2.2.6 non scrivono `inviteId`,
        // e con questa regola il loro join viene negato. Al passaggio negli
        // ultimi 7 giorni non c'era nessuna versione sotto Android 2.2.8 e
        // iOS 2.2.9, e tutti i join reali dal 22/09 (9 su 9) portavano l'invito.
        allow create: if isSignedIn() && (
          (uid == request.auth.uid && (
            joinedWithValidInvite(familyId)
            // Creazione della famiglia: il documento famiglia e quello del
            // proprietario nascono nello stesso batch, e in un batch le rules
            // vedono lo stato PRIMA del commit — la famiglia non esiste ancora,
            // quindi né `isOwner` né un invito possono esistere. Non è una
            // scorciatoia sfruttabile: per entrare in una famiglia **esistente**
            // serve l'invito, e un documento membro depositato sotto un id che
            // non esiste è inerte (gli id sono UUID, non si indovinano).
            || !exists(/databases/$(database)/documents/families/$(familyId))
          ))
          || isOwner(familyId)
        );
        // L'update del proprio documento resta libero (rinominarsi, soft-delete)
        // TRANNE la riattivazione. La revoca da Android non cancella il documento
        // ma lo marca `isDeleted: true`: senza questo vincolo il revocato poteva
        // rimettere `isDeleted: false` da sé e rientrare senza invito. Chi si
        // riattiva deve esibire un invito consumato a proprio nome, e DIVERSO da
        // quello già scritto sul documento — l'`inviteId` del primo ingresso è
        // ancora lì, consumato proprio da lui, e varrebbe come prova eterna.
        // Il rientro legittimo (`addMember` con merge su documento esistente)
        // porta il nuovo `inviteId` su iOS, Android e web dalla 2.2.6.
        allow update: if isSignedIn() && (
          isOwner(familyId)
          || (uid == request.auth.uid && (
            !(resource.data.get('isDeleted', false) == true
              && request.resource.data.get('isDeleted', false) != true)
            || (request.resource.data.get('inviteId', '') != resource.data.get('inviteId', '')
              && joinedWithValidInvite(familyId))
          ))
        );
        allow delete: if isSignedIn() && (uid == request.auth.uid || isOwner(familyId));
        allow get:  if isSignedIn() && (uid == request.auth.uid || isOwner(familyId));
        allow list: if isMemberOrOwner(familyId);
      }
      // NOTA: `members` NON è escluso dal wildcard `{coll}/{docId}` in fondo,
      // quindi un utente **già membro** di questa famiglia può ancora scrivere
      // documenti membro altrui passando di lì. Non è la falla chiusa qui — che
      // riguardava chi è fuori dalla famiglia e conosce solo il `familyId` — ma
      // resta da stringere, insieme all'esclusione di `invites`. Va fatto a
      // parte: tocca chi può rimuovere un membro, e va verificato sulle UI di
      // iOS, Android e web prima di cambiarlo.

      match /invites/{inviteId} {
        // Il GET di un invito è aperto a chiunque sia autenticato: chi riceve il
        // QR o il link non è ancora membro, e senza il `secret` — che sta nel
        // link e non qui — il materiale cifrato è inservibile. Tutti i client
        // (iOS, Android, web, versioni vecchie comprese) leggono l'invito per id:
        // anteprima e transazione di consumo sono `get`.
        //
        // La LIST invece è solo dei membri. Aperta a tutti, bastava conoscere il
        // `familyId` — che nel QR e nel link viaggia in chiaro — per elencare gli
        // inviti pendenti di una famiglia altrui, marcarne uno a proprio nome e
        // presentarlo come prova a `members/{uid}`. Per i membri la lista la dà
        // comunque anche il wildcard delle sottocollezioni: qui è esplicita.
        allow get: if isSignedIn();
        allow list: if isMemberOrOwner(familyId);
        // Crea inviti solo chi è già nella famiglia: con la creazione aperta, un
        // estraneo poteva fabbricarsi un invito con un segreto suo, consumarlo ed
        // entrare, scavalcando qualsiasi controllo su `members/{uid}`.
        // Verificato il 13/09/2026: iOS, Android e web creano l'invito solo dopo
        // che la scrittura della famiglia è confermata dal server.
        allow create: if isMemberOrOwner(familyId);
        // Consumare l'invito. Oltre a `usedAt`/`usedBy` si lascia CANCELLARE il
        // materiale crittografico, e i client lo fanno nella stessa transazione:
        // l'invito ora sopravvive all'uso (serve alle regole di `members` come
        // prova dell'iscrizione), e un documento che resta in giro non deve
        // continuare a contenere la chiave di famiglia wrappata. Consumato,
        // l'invito è una ricevuta inerte.
        //
        // `usedAt == null` resta la condizione: l'invito è a uso singolo, e
        // nessuno può riscrivere `usedBy` su un invito già consumato per
        // spacciarlo come proprio.
        //
        // Chi consuma lo marca a nome proprio e mai di un altro, e solo prima
        // della scadenza: i client lo controllano già, qui diventa vincolante
        // anche per chi scrive con l'SDK a mano. Ogni invito in produzione ha
        // `expiresAt` timestamp (verificato il 13/09/2026, 557 documenti), e i
        // client vecchi scrivono `usedBy = uid`, quindi nessun join legittimo
        // cambia esito. Unico effetto visibile: con l'orologio del telefono
        // indietro, a invito appena scaduto l'utente riceve un permesso negato
        // invece di «invito scaduto».
        allow update: if isSignedIn()
          && resource.data.usedAt == null
          && resource.data.expiresAt is timestamp
          && request.time < resource.data.expiresAt
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usedAt', 'usedBy', 'kdfSalt', 'secretHash',
                      'wrappedKeyCipher', 'wrappedKeyNonce', 'wrappedKeyTag']);
        allow delete: if isMemberOrOwner(familyId);
      }

      // ── Backup della chiave di famiglia (escrow) ──────────
      // Ogni membro può leggere e riscrivere SOLO il proprio documento.
      //
      // Prima ricadeva nel wildcard `{subpath=**}` qui sotto, che lo apriva a
      // ogni membro: e siccome la chiave di unwrap è derivata da (uid, familyId)
      // con costanti compilate nei client, chi leggeva l'escrow altrui poteva
      // ricostruire la master key della famiglia. Non era un problema teorico:
      // `members/{uid}` lasciava a chiunque fosse autenticato la creazione del
      // proprio documento di membro, quindi bastava conoscere il `familyId`
      // (che viaggia in chiaro nel QR d'invito) per iscriversi da soli e
      // arrivare alla chiave. Chiuso qui, dove costava nulla; l'auto-iscrizione
      // è stata chiusa a parte il 01/10/2026 (vedi `members/{uid}`).
      //
      // Nessun client ha mai letto l'escrow di un altro utente — iOS, Android e
      // web passano tutti da (userId corrente, familyId) — quindi la stretta è
      // trasparente. Il ramo è anche escluso dal wildcard: le rules sono in OR,
      // e senza quell'esclusione questa regola più stretta non restringerebbe
      // nulla.
      match /memberKeyBackups/{memberUid} {
        allow read, write: if isSignedIn() && request.auth.uid == memberUid;
      }

      match /counters/{uid} {
        allow get: if isSignedIn()
          && request.auth.uid == uid
          && isMemberOrOwner(familyId);
        allow create, update, delete: if false;
      }

      // ── Zone di arrivo (geofence) ─────────────────────────
      match /geofences/{geofenceId} {
        allow read: if isMemberOrOwner(familyId);
        allow create, update: if isMemberOrOwner(familyId);
        allow delete: if isOwner(familyId);
      }

      match /geofenceEvents/{eventId} {
        allow read: if isMemberOrOwner(familyId);
        allow create: if isMemberOrOwner(familyId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['arrive', 'leave']
          && request.resource.data.geofenceId is string
          && request.resource.data.geofenceId.size() > 0
          && request.resource.data.displayName is string
          && request.resource.data.keys().hasAll([
            'geofenceId', 'uid', 'displayName', 'type', 'timestamp'
          ]);
        allow update, delete: if false;
      }

      // ── Richieste («Chi prende Marco giovedì?») ───────────
      // Disegno in internal/richieste-disegno.md. Il client di chi chiede la
      // CREA; tutto il resto — risposte, «il primo Io vince», il to-do che
      // nasce, la scadenza, l'apertura del link esterno — lo scrive solo il
      // server (`respondToRequest`, `requestPublic`, `expireFamilyRequests`),
      // che passa dall'Admin SDK. Esclusa dal wildcard più sotto: le rules sono
      // in OR, e senza l'esclusione un membro potrebbe marcarsi da solo come
      // chi l'ha presa.
      match /requests/{requestId} {
        allow read: if isMemberOrOwner(familyId);
        // `createdVia` diverso da 'app' (assistente, connettore) lo scrive
        // solo il server. `listId` obbligatorio: il to-do che nasce senza una
        // lista valida su Android non si vede (foreign key di Room).
        // La scadenza ha un'ora di margine sui 7 giorni per l'orologio del
        // telefono. `external` porta solo ciò che sa chi chiede: l'impronta del
        // token e l'invito; `openedAt`/`answeredAt` li scrive il server.
        allow create: if isMemberOrOwner(familyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.kind == 'todo'
          && request.resource.data.get('createdVia', 'app') == 'app'
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.listId is string
          && request.resource.data.listId.size() > 0
          && request.resource.data.recipients is list
          && request.resource.data.recipients.size() <= 20
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(169, 'h')
          && !request.resource.data.keys().hasAny([
            'responses', 'claimedBy', 'claimedAt', 'todoId',
            'resolvedAt', 'allDeclinedAt', 'cancelledAt',
            'nudgeAt', 'nudgedAt'
          ])
          && (request.resource.data.get('external', null) == null
            || (request.resource.data.external.keys().hasOnly(['label', 'tokenHash', 'inviteId'])
              && request.resource.data.external.tokenHash is string
              && request.resource.data.external.tokenHash.size() == 64));
        // L'unica modifica dal client: chi ha chiesto la ritira finché è aperta.
        allow update: if isMemberOrOwner(familyId)
          && resource.data.get('createdBy', '') == request.auth.uid
          && resource.data.get('status', '') == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt']);
        // La storia serve alla misura: nessuno cancella dal client.
        allow delete: if false;
      }

      // BEGIN next:memoryFacts
      // ⏳ Regola in attesa: i fatti della memoria AI solo cifrati (`contentEnc`).
      // Esclusi dalle scritture del wildcard qui sotto, che altrimenti la
      // scavalcherebbe (le rules sono in OR); la lettura resta al wildcard.
      match /memoryFacts/{factId} {
        allow delete: if isMemberOrOwner(familyId);
        allow create, update: if isMemberOrOwner(familyId) && memoryFactWriteIsEncrypted();
      }
      // END next:memoryFacts

      // Il wildcard delle sottocollezioni: `{coll}` è il nome della prima
      // sottocollezione, `{subpath=**}` (che combacia anche con zero segmenti)
      // tutto ciò che sta più in fondo.
      //
      // Perché non un solo `{subpath=**}` letto con `subpath[0]`: in una LIST
      // il capture `**` NON è legato, e qualunque rule che lo legga va in
      // "Variable is not bound in path template" — cioè nega la query a tutti,
      // membri e proprietario. È esattamente quello che è successo dopo aver
      // aggiunto l'esclusione di `memberKeyBackups`: le scritture, che non
      // guardano il path, passavano; ogni query di collezione veniva negata.
      // Un capture di UN segmento come `{coll}` è invece legato anche in list.
      //
      // Il documento famiglia stesso non combacia (servono almeno 2 segmenti):
      // la sua `allow update` resta l'unica strada, e `keepsPlanFields()` non
      // è scavalcabile da qui.
      match /{coll}/{docId}/{subpath=**} {
        // `memberKeyBackups` è escluso: ha una regola sua, più stretta, e le
        // rules in OR la renderebbero inutile.
        allow read: if isMemberOrOwner(familyId)
          && coll != 'memberKeyBackups';
        // `requests` ha una regola sua (sopra): il client la crea e la ritira,
        // il resto lo scrive il server.
        // `calendarFeeds` lo scrive solo la function `saveCalendarFeed`: URL
        // validato lato server ed eventi presi dal download, non dal client.
        // `geofenceState` lo scrive solo `onGeofenceEvent`: dal client bastava
        // un `pendingLeaveDueAt` per far mandare a tutti un falso «è uscito».
        // `locations/{uid}` e le sue coordinate (`live/current`) li scrive solo
        // quell'uid: iOS, Android e web scrivono sempre il proprio, e prima un
        // membro poteva spostare la posizione di un altro o spegnergli la
        // condivisione. `docId` è un capture di un segmento, legato anche in list.
        allow write: if isMemberOrOwner(familyId)
          && coll != 'geofences'
          && coll != 'geofenceEvents'
          && coll != 'geofenceState'
          && coll != 'memberKeyBackups'
          && coll != 'calendarFeeds'
          && coll != 'requests'
          // BEGIN next:memoryFacts-excl
          && coll != 'memoryFacts'
          // END next:memoryFacts-excl
          && (coll != 'locations' || docId == request.auth.uid);
      }
    }

    // ── SUPPORT TICKETS (Assistente & Supporto) ───────────
    match /support_tickets/{ticketId} {
      function supportTicketRequiredKeys() {
        return [
          'id', 'familyId', 'uid', 'userEmail', 'type', 'title', 'summary',
          'conversation', 'images', 'platform', 'appVersion', 'osVersion',
          'device', 'status', 'createdAt',
        ];
      }

      function validSupportTicketData() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.familyId is string
          && isMemberOrOwner(request.resource.data.familyId)
          && request.resource.data.type in ['question', 'bug', 'suggestion']
          && request.resource.data.status == 'new'
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.keys().hasAll(supportTicketRequiredKeys())
          && request.resource.data.conversation is list
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 5
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 2000
          && (
            !('rawLogs' in request.resource.data)
            || (
              request.resource.data.rawLogs is string
              && request.resource.data.rawLogs.size() <= 51200
            )
          );
      }

      allow create: if isSignedIn() && validSupportTicketData();

      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.familyId == resource.data.familyId
          && validSupportTicketData());

      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ── CRASH REPORTS (log anonimi, opt-in utente) ────────
    match /crash_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.platform in ['ios', 'android']
        && request.resource.data.status == 'new'
        && request.resource.data.keys().hasAll([
          'platform', 'appVersion', 'osVersion', 'device',
          'issues', 'rawLogs', 'createdAt', 'status', 'userId'
        ])
        && request.resource.data.rawLogs is string
        && request.resource.data.rawLogs.size() <= 51200
        && request.resource.data.issues is list;
      allow read, update, delete: if false;
    }

    // ── DIAGNOSTICS ────────────────────────────────────────
    // Chiusa: era `if true`, quindi lettura e scrittura non autenticate da
    // chiunque conoscesse il project id. L'unico client che la usava era il
    // ping di `FirestorePingService`, compilato solo sotto `#if DEBUG`:
    // nessun percorso di produzione tocca questa collection.
    match /diagnostics/{doc} {
      allow read, write: if false;
    }
  }
}
